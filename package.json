{
  "name": "plantview-demo-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test demo_data_generator/tests/*.test.js",
    "lint": "node demo_data_generator/checkSyntax.js",
    "build": "node demo_data_generator/cli.js validate",
    "demo-generator:normal-once": "node demo_data_generator/cli.js normal-once",
